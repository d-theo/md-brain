{
  "name": "md-brain",
  "version": "0.1.0",
  "private": true,
  "description": "Local knowledge base over a folder of Markdown notes, exposed to agents over MCP",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "mdb": "node dist/cli/mdb.js",
    "test:coverage": "vitest run --coverage"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@qdrant/js-client-rest": "1.20.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-string": "4.0.0",
    "micromark-extension-gfm": "3.0.0",
    "ollama": "0.6.4",
    "picomatch": "4.0.7",
    "pino": "10.4.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "@types/picomatch": "4.0.3",
    "@vitest/coverage-v8": "5.1.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
